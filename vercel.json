{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "installCommand": "npm install",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet .",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "app/routes/**/*.ts": {
      "maxDuration": 30
    }
  }
}
